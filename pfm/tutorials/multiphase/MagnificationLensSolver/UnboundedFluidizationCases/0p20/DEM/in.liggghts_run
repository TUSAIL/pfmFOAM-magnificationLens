################################################################################
# brief: 2 tiny spheres in a fluid to compare against OpenFOAM solution        #
#                                                                              #
# Cf. J. Guerrero, 2D Circular cylinder - Vortex shedding (c24)                #
# https://wiki.openfoam.com/Vortex_shedding_by_Joel_Guerrero_2D                #
# published under CC BY-SA license                                             #
#                                                                              #
# authors: Daniel Queteschiner                                                 #
# date: Nov 2021                                                               #
# copyright: 2021- JKU Linz                                                    #
################################################################################

log             ../DEM/log.liggghts
thermo_log      ../DEM/post/thermo.txt

# define the attributes associated with the particles,
# 'granular' (or 'sphere') style uses diameter, mass and angular velocity
atom_style      granular

# use an array to map particle IDs to local storage index,
atom_modify     map array

# set simulation domain to be fixed in x y z
boundary        p p f

# save communication by turning off Newton's 3rd law for pairwise interaction,
# note: this setting only influences communication between procs, Newton's
# 3rd law is still used for contact force calculations
newton          off

# use a single value for ghost particle cutoff distance and
# enable velocity to be communicated with ghost particles
communicate     single vel yes

# set unit system to SI
units           si

# specify domain decomposition for parallel execution
processors      8 4 1
# read the restart file
read_restart    ../DEM/post/restart/liggghts.restart
reset_timestep 0


# define the region used as simulation domain (min/max X, min/max Y, min/max Z)
#region          domain block -0.004 0.004 -0.0005 0.0005 -0.004375 0.004375 units box

# create the simulation domain and 1 material type for particle
#create_box      1 domain

# specify the skin distance for neighbor list generation
neighbor        0.0002 bin
neigh_modify    delay 0

# define the material properties required for granular pair styles
fix m1 all property/global youngsModulus peratomtype 1e6 
fix m2 all property/global poissonsRatio peratomtype 0.42 
fix m3 all property/global coefficientRestitution peratomtypepair 1 0.9  
fix m4 all property/global coefficientFriction peratomtypepair 1 0.1 

# specify contact model to use
pair_style  gran model hertz tangential incremental_history limitForce on
pair_coeff * *

timestep    0.000001

# set diameter and density
#set             atom 1 diameter 7.5e-5 density 1500
fix pts1 all particletemplate/sphere 98531 atom_type 1 volume_limit 1e-14 density constant 1500 radius constant 3.75e-5
fix pdd1 all particledistribution/discrete 746325 1 pts1 1.0
# apply gravity
fix gravity all gravity 9.81 vector 0.0 0.0 -1.0

fix zwall1 all wall/gran model hertz tangential incremental_history primitive type 1 zplane 0.004375
fix zwall2 all wall/gran model hertz tangential incremental_history primitive type 1 zplane -0.004375
# cfd coupling
fix cfd  all couple/cfd couple_every 50 mpi
fix cfd2 all couple/cfd/force/implicit

fix cfd3 all couple/cfd/face/tfm n_patches 2 n_faceids 1024 1024
fix cfd4 all couple/cfd/cell/tfm n_patches 2 n_cells 1024 1024

#TOP
fix surfaceTop all mesh/surface file ../DEM/meshes/wallTop.stl type 1 verbose yes cell_data no
fix massTopOut all massflow/mesh mesh surfaceTop count once vec_side 0. 0. 1. delete_atoms yes

#Bottom
fix surfaceBottom all mesh/surface file ../DEM/meshes/wallBottom.stl type 1 verbose yes cell_data no
fix massBottomOut all massflow/mesh mesh surfaceBottom count once vec_side 0. 0. -1. delete_atoms yes

#insertion
fix massflux all massflow/mesh/face/tfm couple_every 50 n_MagnificationLensFaces 2048 density 1500 radius 3.75e-5 insertion_frequency 5

region hexRegion1 mesh/hex file ../DEM/meshes/TopInsertion.vtk scale 1. move 0. 0. 0.0 rotate 0. 0. 0.0 cell_data yes units box
region hexRegion2 mesh/hex file ../DEM/meshes/BottomInsertion.vtk scale 1. move 0. 0. 0.0003 rotate 0. 0. 0.0 cell_data yes units box

fix insMagLens1 all insert/pack/face/tfm seed 7331 random_distribute exact maxattempt 100 insert_every 250 start 1002&
    overlapcheck yes all_in yes region hexRegion1 ntry_mc 1500 massflow_face massflux start_index 0 end_index 1023 n_MagnificationLensFaces 1024

fix insMagLens2 all insert/pack/face/tfm seed 7331 random_distribute exact maxattempt 100 insert_every 250 start 1002&
    overlapcheck yes all_in yes region hexRegion2 ntry_mc 1500 massflow_face massflux start_index 1024 end_index 2047 n_MagnificationLensFaces 1024

variable nevery equal 50
variable nevery equal ${nevery}
variable one_over_nevery equal 1.0/${nevery}
variable one_over_neverydt equal 1.0/(${nevery}*dt)


# use constant NVE integration to update position, velocity and angular velocity
fix         integr all nve/sphere

thermo_style    custom step atoms

# set frequency of output
thermo          1000

# ignore particles leaving the simulation domain,
# do not normalize thermodynamic output values by the number of atoms
thermo_modify   lost ignore norm no

# set dynamic to 'no' as number of particles does not change
compute_modify  thermo_temp dynamic no

# output particle properties (same frequency as CFD output)
dump dmp all custom/vtk 10000 ../DEM/post/liggghts_run_*.vtk id type x y z vx vy vz &
     fx fy fz omegax omegay omegaz radius


run 1


