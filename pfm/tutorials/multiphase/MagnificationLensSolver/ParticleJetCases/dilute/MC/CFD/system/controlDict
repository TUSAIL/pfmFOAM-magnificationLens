FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
application     twoPhaseEulerTurbFoamJet;

startTime       0;

startFrom       startTime;

stopAt          endTime;

endTime         2;

deltaT          0.000005;

writeControl    adjustableRunTime;

writeInterval   0.01;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable on;

adjustTimeStep  no;

functions
{
    fieldAverage1
    {
        type            fieldAverage;
        functionObjectLibs ( "libfieldFunctionObjects.so" );
        writeControl   writeTime;
        fields
        (
            U.particles
            {
                 mean        on;
                 prime2Mean  off;
                 base        time;
                 window      1.5;
            }

            U.air
            {
                 mean        on;
                 prime2Mean  off;
                 base        time;
                 window      1.5;
            }

            alpha.particles
            {
                 mean        on;
                 prime2Mean  off;
                 base        time;
                 window      1.5;
            }
  
	    T.particles
            {
                 mean        on;
                 prime2Mean  off;
                 base        time;
                 window      1.5;
            }

            T.air
            {
                 mean        on;
                 prime2Mean  off;
                 base        time;
                 window      1.5;
            }
            
            Theta.particles
            {
                 mean        on;
                 prime2Mean  off;
                 base        time;
                 window      1.5;
            }

            voidfraction
            {
                 mean        on;
                 prime2Mean  off;
                 base        time;
                 window      1.5;
            }
            
            Us
            {
                 mean        on;
                 prime2Mean  off;
                 base        time;
                 window      1.5;
            }            
            
        );
    }
}


