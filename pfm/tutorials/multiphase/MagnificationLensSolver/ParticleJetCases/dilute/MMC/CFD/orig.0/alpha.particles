FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.particles;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inletGas
    {
        type            zeroGradient;
    }

    InletSolidLeft
    {
        type            fixedValue;
        value           uniform 0.02;
    }

    InletSolidRight
    {
        type            fixedValue;
        value           uniform 0.02;
    }

    walls
    {
        type            zeroGradient;
    }

    outlet
    {
        type            zeroGradient;
    }

    frontAndBackPlanes    
    {
        type            empty;
    }

    magLens_top_master
    {
        type            empty;
    } 
       
    magLens_top_slave
    {
        type            empty;
    }  
  
    magLens_bottom_master
    {
        type            cyclic;
    } 
       
    magLens_bottom_slave
    {
        type            cyclic;
    }  
}

// ************************************************************************* //
