FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U.particles;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    
    inletGas
    {
       type                slip;
    }

    InletSolidLeft
    {
        type            fixedValue;
        value           uniform (10 0 10);
    }

    InletSolidRight
    {
        type            fixedValue;
        value           uniform (-10 0 10);
    }

    walls
    {
        type                            particleSlipSoleimaniSchneiderbauer;
        restitutionCoefficient          0.99;
        tangentialRestitutionCoeff      0.99;
        muF                             0.05;
        sigma                           0;
        value                           $internalField;
        
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        phi             phi.particles;
        value           $internalField; 
    }

    frontAndBackPlanes    
    {
        type            empty;
    } 

    magLens_top_master
    {
        type            empty;
    } 
       
    magLens_top_slave
    {
        type            empty;
    }
    
    magLens_bottom_master
    {
        type            cyclic;
    } 
       
    magLens_bottom_slave
    {
        type            cyclic;
    }           
}

// ************************************************************************* //
