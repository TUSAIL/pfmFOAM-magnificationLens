FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [1 -1 -2 0 0 0 0];

internalField       uniform 1e5;

boundaryField
{
    
    inletGas
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    InletSolidLeft
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    InletSolidRight
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    walls
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    outlet
    {
        type 	fixedValue;
        value 	$internalField;
    }

    frontAndBackPlanes    
    {
        type            empty;
    }    

    magLens_top_master
    {
        type            empty;
    } 
       
    magLens_top_slave
    {
        type            empty;
    }
    
    magLens_bottom_master
    {
        type            cyclic;
    } 
       
    magLens_bottom_slave
    {
        type            cyclic;
    }      
}

