FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alphat.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
   
    inletGas
    {
        type            calculated;
        value           $internalField;
    }

    InletSolidLeft
    {
        type            calculated;
        value           $internalField;
    }

    InletSolidRight
    {
        type            calculated;
        value           $internalField;
    }

    walls
    {
        type            compressible::alphatWallFunction;
        Prt             0.85;
        value           $internalField;
    }

    outlet
    {
        type            calculated;
        value           $internalField;
    }

    frontAndBackPlanes    
    {
        type            empty;
    }

    magLens_top_master
    {
        type            empty;
    } 
       
    magLens_top_slave
    {
        type            empty;
    }
        
    magLens_bottom_master
    {
        type            cyclic;
    } 
       
    magLens_bottom_slave
    {
        type            cyclic;
    }     
}

// ************************************************************************* //
