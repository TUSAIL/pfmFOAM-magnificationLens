FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{

    inletGas
    {
        type            fixedValue;
        value           uniform (0 0 25);
    }

    InletSolidLeft
    {
        type            fixedValue;
        value           uniform (10 0 10);
    }

    InletSolidRight
    {
        type            fixedValue;
        value           uniform (-10 0 10);
    }

    walls
    {
        type            noSlip;
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        phi             phi.air;
        value           $internalField;
    }

    frontAndBackPlanes    
    {
        type            empty;
    }  

    magLens_top_master
    {
        type            empty;
    } 
       
    magLens_top_slave
    {
        type            empty;
    }
    
    magLens_bottom_master
    {
        type            cyclic;
    } 
       
    magLens_bottom_slave
    {
        type            cyclic;
    }        
}

// ************************************************************************* //
