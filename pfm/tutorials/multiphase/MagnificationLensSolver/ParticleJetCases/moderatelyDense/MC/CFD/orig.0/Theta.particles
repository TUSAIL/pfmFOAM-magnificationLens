  =========                 |
  \\      /  F ield         | OpenFOAM: The Open Source CFD Toolbox
   \\    /   O peration     | Website:  https://openfoam.org
    \\  /    A nd           | Version:  6  
     \\/     M anipulation  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Theta.particles;
}
// ************************************************************************* //

dimensions          [0 2 -2 0 0 0 0];

internalField       uniform 0;

referenceLevel      1e-4;

boundaryField
{
    
    inletGas
    {
        type               zeroGradient;
    }

    InletSolidLeft
    {
        type               fixedValue; 
        value              uniform $referenceLevel;
    }

    InletSolidRight
    {
        type               fixedValue; 
        value              uniform $referenceLevel;
    }

    walls
    {
        type                            particleThetaSoleimaniSchneiderbauer;
        restitutionCoefficient          0.99;
        tangentialRestitutionCoeff      0.99;
        muF                             0.05;
        sigma                           0;
        value                           $internalField;
            
    }

    outlet
    {
        type               zeroGradient;
    }

    frontAndBackPlanes    
    {
        type            empty;
    }     

    magLens_top_master
    {
        type            empty;
    } 
       
    magLens_top_slave
    {
        type            empty;
    }
    
    magLens_bottom_master
    {
        type            cyclic;
    } 
       
    magLens_bottom_slave
    {
        type            cyclic;
    }  

}

// ************************************************************************* //
