FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties.particles;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  RAS;

RAS
{
    RASModel kineticTheory;

    turbulence      on;
    printCoeffs     on;
    
    SATFMdispersedCoeffs
    {
        equilibrium             off;  // equilibrium assumption: production of k == dissipation
        dynamicAdjustment       on;  // dynamic adjustment of model coefficient and correlation coefficients
	    anIsoTropicNut          on;  // anisotropic treatment of shear component of Reynolds-stress tensor
        
        alphaMax                0.65;   // maximum dispersed phase volume fraction
        alphaMinFriction        1e-4; // friction stresses are solely computed for alpha > alphaMinFriction
        residualAlpha           1e-4;  // minimum dispersed phase volume fraction for dispersed phase Reynolds stress

        xiPhiS                  0.10; // correlation coefficient between dispersed phase volume fraction and continuous phase velocity
        xiGS                    0.90; // correlation coefficient between dispersed phase velocity and continuous phase velocity
        Cmu                     0.3; // smagorinsky constant for turbulent viscosity   
        Ceps                    0.4; // constant for mixing length model of turbulent dissipation rate
        Cp                      1.0;
        Sigma                   0.75; // turbulent schmidt number        
        CphiS                   1.0; // turbulent schmidt number      
        //g                       (0 0 -9.81);

        maxK                    30.0; // Limits Reynolds stresses
        
	filter                  laplaceAnIso2nd; // test filter for dynamic adjustment of model constants    
	laplaceAnIso2ndCoeffs   
	{
		widthCoeff		7.0;
	}
		
		frictionalStressModel   SchneiderbauerEtAl; // frictional model (e.g. SchneiderbauerEtAl)
        SchneiderbauerEtAlCoeffs
        {
            b                0.2;
            muSt             0.38;
            muC              0.64;
            I0               0.279;
            aQSk		   	 1000;
	    	alphaDeltaMin    0.0025;
        }		
    }
    ADMdispersedCoeffs
    {
        alphaMax                0.6;   // maximum dispersed phase volume fraction
        alphaMinFriction        0.001; // friction stresses are solely computed for alpha > alphaMinFriction
        residualAlpha           1e-3;  // minimum dispersed phase volume fraction for dispersed phase Reynolds stress
        maxK                    0.04;  // Limits Reynolds stresses
        deconOrder              2;     // deconvolution Order

		filter                  laplaceAnIso2nd; // filter for ADM    
		laplaceAnIso2ndCoeffs   
		{
			widthCoeff		24.0;
		}
		
        regularizationModel     none;  // regularization model (e.g. Stolz)
        StolzCoeffs
        {
        	smagConst       0.25;
        	lengthConst     0.3;	
        	filter          laplaceAnIso2nd; // filter for Stolz    
        	laplaceAnIso2ndCoeffs   
        	{
        		widthCoeff		24.0;
        	}
        }
        
        frictionalStressModel   SchneiderbauerEtAl; // frictional model (e.g. SchneiderbauerEtAl)
        SchneiderbauerEtAlCoeffs
        {
            b                0.2;
            muSt             0.38;
            muC              0.64;
            I0               0.279;
            aQSk		   	 1000;
	    	alphaDeltaMin    0.0025;
        }		
    }
    kineticTheoryCoeffs
    {
        equilibrium             off;
        e                       0.8;
        alphaMax                0.65;
        alphaMinFriction        0.5;
        residualAlpha           1e-6;

        viscosityModel          SchneiderbauerEtAl; 
        conductivityModel       SchneiderbauerEtAl;
        granularPressureModel   SchneiderbauerEtAl;
        frictionalStressModel   ChialvoEtAl;
        radialModel             Arastoopour;
        
        KochSanganiDrag         off;
        
        ChialvoEtAlCoeffs
        {
            alpha            1.6;
            L                0.045;
            b                0.2;
            muSt             0.105;
            muC              0.4805;
            I0               0.32;
            aQSk             0.095; 
            aInt             0.1;
            k                1.0e3;
            alphaDeltaMin    0.01;
            Rc               0.0; 
        }	       
        SchneiderbauerEtAlCoeffs
        {
            alpha            1.6;
            L                0.001;
            b                0.2;
            muSt             0.105;
            muC              0.4805;
            I0               0.32;
            aQSk             0.095; 
            aInt             0.1;
            k                1.0e3;
            alphaDeltaMin    0.01;
            Rc               0.0; 
        }		
        SchaefferCoeffs
        {
            phi                     28;
        }	
    }


    phasePressureCoeffs
    {
        preAlphaExp     500;
        expMax          1000;
        alphaMax        0.65;
        g0              1000;
    }
}


// ************************************************************************* //
