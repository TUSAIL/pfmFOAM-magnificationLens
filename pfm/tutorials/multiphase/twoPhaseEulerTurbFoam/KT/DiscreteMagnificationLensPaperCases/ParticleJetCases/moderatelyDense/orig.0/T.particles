FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T.particles;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [0 0 0 1 0 0 0];

internalField       uniform 300;

boundaryField
{
    inletGas
    {
        type               fixedValue;
        value              uniform 300;
    }

    InletSolidLeft
    {
        type               fixedValue;
        value              uniform 300;
    }

    InletSolidRight
    {
        type               fixedValue;
        value              uniform 300;
    }

    walls
    {
        type               calculated;
        value              $internalField;
    }

    outlet
    {
        type               fixedValue;
        value              $internalField;
    }

    frontAndBackPlanes    
    {
        type            empty;
    } 
    
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
